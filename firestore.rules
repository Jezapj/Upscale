rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /userdata/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /pushSubscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /dailyBoards/{boardId}/entries/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'score', 'displayName', 'playedAt', 'gameId', 'day'])
        && request.resource.data.uid == userId
        && request.resource.data.score is number
        && request.resource.data.playedAt is string
        && request.resource.data.gameId is string
        && request.resource.data.day is string
        && (request.resource.data.displayName == null || request.resource.data.displayName is string);

      allow update, delete: if false;
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'createdAt']);
      allow update, delete: if false;
    }

    match /social/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.keys().hasAll(['fromUid', 'toUid', 'fromName', 'createdAt', 'status']);

      // Recipient can mark pending -> accepted; sender can create accept mirrors.
      allow update: if request.auth != null
        && (
          (resource.data.toUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted')
          || resource.data.fromUid == request.auth.uid
        );

      allow delete: if false;
    }

    match /publicStats/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'bestStreak', 'daysActiveThisWeek',
          'completedToday', 'updatedAt'
        ])
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /kudos/{recipientUid}/days/{day}/from/{senderUid} {
      allow read: if request.auth != null
        && (request.auth.uid == recipientUid || request.auth.uid == senderUid);
      allow create: if request.auth != null
        && request.auth.uid == senderUid
        && request.resource.data.fromUid == senderUid
        && request.resource.data.day == day;
      allow update, delete: if false;
    }
  }
}
