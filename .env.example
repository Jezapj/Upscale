# Optional Google Sign-In.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Add your dev origin (e.g. http://localhost:5173) to "Authorized JavaScript origins".
# Then copy the Client ID below. If left blank, the app runs in Guest mode.
VITE_GOOGLE_CLIENT_ID=

# Firebase (cross-device sync for Google accounts)
# https://console.firebase.google.com: enable Auth (Google) + Firestore
# Deploy firestore.rules from this repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
# Generate a key pair and paste the public key here. Needed for closed-app reminders.
VITE_FIREBASE_VAPID_KEY=

# Public site origin used for sitemap, canonical, and Open Graph URLs (no trailing slash).
VITE_PUBLIC_SITE_URL=https://getupscale.app

# Arcade Pro: RevenueCat Web Billing (recommended)
# 1. Connect Stripe in RevenueCat → Account settings
# 2. Create a Web Billing app with $10/month product
# 3. Create entitlement "pro" and link the product
# 4. Copy the Web Billing public API key (sandbox or production)
VITE_REVENUECAT_API_KEY=

# Stripe (direct Checkout fallback + server API routes on Vercel)
# Create a $10/month recurring price in Stripe Dashboard and copy the Price ID.
# Server-only secrets: set in Vercel Project Settings (not prefixed with VITE_):
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_PRICE_ID=price_...
#   STRIPE_WEBHOOK_SECRET=whsec_...  (optional, for webhook endpoint)
#   APP_URL=https://getupscale.app  (fallback checkout return origin; client usually sends window.location.origin)
VITE_STRIPE_PUBLISHABLE_KEY=

# Dev only: set to true to bypass endless play limits
# VITE_UNLIMITED_PLAYS=true
